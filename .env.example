# 模型設定也可以直接在網頁右上角的「模型設定」填寫（會存到 .roko/settings.json，優先於這裡）
# 任何 OpenAI 相容的 API 都可以（OpenAI、OpenRouter、Groq、DeepSeek、vLLM、Ollama…）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# 伺服器
PORT=3000
HOST=127.0.0.1

# Agent 每則訊息最多執行的步數；遇到「Recursion limit」錯誤時調高
RECURSION_LIMIT=1000
