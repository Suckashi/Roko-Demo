{
  "name": "roko-demo",
  "version": "0.2.0",
  "private": true,
  "description": "A minimal TypeScript chat bot built on Deep Agents, talking to any OpenAI-compatible API.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch src/server.ts\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -b web",
    "test": "vitest run && npm test -w web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.12.1",
    "@langchain/openai": "^1.6.2",
    "deepagents": "^1.14.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "langchain": "^1.5.15",
    "langsmith": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
