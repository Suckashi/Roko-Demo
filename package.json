{
  "name": "roko-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal TypeScript chat bot built on Deep Agents, talking to any OpenAI-compatible API.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch src/server.ts\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -b web"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/langgraph-sdk": "^1.12.1",
    "@langchain/openai": "^1.6.2",
    "deepagents": "^1.14.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "langchain": "^1.5.15",
    "langsmith": "^0.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
